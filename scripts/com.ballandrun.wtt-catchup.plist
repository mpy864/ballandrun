<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ballandrun.wtt-catchup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mohityadav/ballandrun/scripts/run_catchup.sh</string>
    </array>

    <!-- Run immediately on load, then every hour as safety net for missed results -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/Users/mohityadav/ballandrun/logs/catchup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mohityadav/ballandrun/logs/catchup.log</string>
</dict>
</plist>
