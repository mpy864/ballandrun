<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this agent -->
    <key>Label</key>
    <string>com.ballandrun.wtt-live</string>

    <!-- Script to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mohityadav/tops-tt-dashboard/scripts/run_live_updater.sh</string>
    </array>

    <!-- Start immediately when agent is loaded (login / launchctl load) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if the process exits for any reason -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait 30s before restarting to avoid tight crash loops -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Log output -->
    <key>StandardOutPath</key>
    <string>/Users/mohityadav/tops-tt-dashboard/logs/live_updater.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mohityadav/tops-tt-dashboard/logs/live_updater.log</string>
</dict>
</plist>
